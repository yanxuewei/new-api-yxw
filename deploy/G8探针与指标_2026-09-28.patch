+package router
+
+import (
+	"github.com/QuantumNous/new-api/controller"
+
+	"github.com/gin-gonic/gin"
+)
+
+// SetProbeRouter registers the Kubernetes/ALB liveness and readiness probes.
+// They sit outside the /api group on purpose: that group applies gzip, access
+// audit and the global API rate limiter, and a probe that can be rate limited
+// is a probe that restarts healthy pods under load. Registering at engine scope
+// keeps the probe handlers clear of those middlewares; middleware.ProbePaths
+// keeps them out of the access log too, since kubelet and ALB probe every few
+// seconds per pod and that volume would dominate the log bill.
+func SetProbeRouter(router *gin.Engine) {
+	router.GET("/healthz", controller.Healthz)
+	router.GET("/readyz", controller.Readyz)
+}
