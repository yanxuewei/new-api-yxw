diff --git a/pkg/httpmetrics/metrics.go b/pkg/httpmetrics/metrics.go
new file mode 100644
index 000000000..f9ba6fdb9
--- /dev/null
+++ b/pkg/httpmetrics/metrics.go
@@ -0,0 +1,289 @@
+// Package httpmetrics publishes operational metrics consumed by the
+// deployment probes and SLO dashboards: request volume, latency histogram,
+// rate-limit rejections and degradations, and upstream channel errors.
+//
+// It is intentionally a leaf package: callers opt in through Init so the
+// package stays usable from tests and from the standalone metrics listener.
+package httpmetrics
+
+import (
+	"database/sql"
+	"net/http"
+	"strconv"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+
+	"github.com/gin-gonic/gin"
+	"github.com/go-redis/redis/v8"
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/prometheus/client_golang/prometheus/collectors"
+	"github.com/prometheus/client_golang/prometheus/promhttp"
+)
+
+const namespace = "newapi"
+
+// durationBuckets covers both the management-plane millisecond calls and the
+// relay SSE streams, which legitimately run for minutes.
+var durationBuckets = []float64{0.05, 0.1, 0.25, 0.5, 1, 2.5, 5, 10, 30, 60, 120, 300, 600}
+
+var (
+	registry *prometheus.Registry
+	live     bool
+
+	httpRequestsTotal = prometheus.NewCounterVec(prometheus.CounterOpts{
+		Namespace: namespace,
+		Subsystem: "http",
+		Name:      "requests_total",
+		Help:      "Count of HTTP requests handled, by route template, method and status code.",
+	}, []string{"route", "method", "code"})
+
+	httpRequestDuration = prometheus.NewHistogramVec(prometheus.HistogramOpts{
+		Namespace: namespace,
+		Subsystem: "http",
+		Name:      "request_duration_seconds",
+		Help:      "End-to-end request duration, including streamed responses.",
+		Buckets:   durationBuckets,
+	}, []string{"route", "method"})
+
+	httpInFlight = prometheus.NewGaugeVec(prometheus.GaugeOpts{
+		Namespace: namespace,
+		Subsystem: "http",
+		Name:      "in_flight_requests",
+		Help:      "Requests currently being handled, by method.",
+	}, []string{"method"})
+
+	rateLimitedTotal = prometheus.NewCounterVec(prometheus.CounterOpts{
+		Namespace: namespace,
+		Subsystem: "rate_limit",
+		Name:      "rejected_total",
+		Help:      "Requests rejected with 429, by limiter mark.",
+	}, []string{"mark"})
+
+	rateLimitDegradedTotal = prometheus.NewCounterVec(prometheus.CounterOpts{
+		Namespace: namespace,
+		Subsystem: "rate_limit",
+		Name:      "degraded_total",
+		Help:      "Rate limit checks that could not reach Redis, by limiter mark and fallback taken.",
+	}, []string{"mark", "fallback"})
+
+	upstreamErrorsTotal = prometheus.NewCounterVec(prometheus.CounterOpts{
+		Namespace: namespace,
+		Subsystem: "relay",
+		Name:      "upstream_errors_total",
+		Help:      "Upstream channel errors observed, by channel id, upstream status and error code.",
+	}, []string{"channel", "status", "error_code"})
+
+	buildInfo = prometheus.NewGaugeVec(prometheus.GaugeOpts{
+		Namespace: namespace,
+		Name:      "build_info",
+		Help:      "Build identity of this process; always 1.",
+	}, []string{"version", "node_type"})
+)
+
+// Init enables collection. Until it is called every Observe* function is a
+// no-op, so an unconfigured deployment pays nothing for this package.
+func Init(version string) {
+	registry = prometheus.NewRegistry()
+	registry.MustRegister(
+		collectors.NewGoCollector(),
+		collectors.NewProcessCollector(collectors.ProcessCollectorOpts{}),
+		httpRequestsTotal,
+		httpRequestDuration,
+		httpInFlight,
+		rateLimitedTotal,
+		rateLimitDegradedTotal,
+		upstreamErrorsTotal,
+		buildInfo,
+	)
+	buildInfo.WithLabelValues(version, nodeType()).Set(1)
+	live = true
+}
+
+func nodeType() string {
+	if common.IsMasterNode {
+		return "master"
+	}
+	return "slave"
+}
+
+// Handler serves the private registry; the metrics listener is the only
+// consumer. It must never be mounted on the public application port.
+func Handler() http.Handler {
+	if !live {
+		return http.NotFoundHandler()
+	}
+	return promhttp.HandlerFor(registry, promhttp.HandlerOpts{
+		ErrorHandling:       promhttp.ContinueOnError,
+		MaxRequestsInFlight: 4,
+	})
+}
+
+// RegisterSQLPool exposes database connection-pool saturation, which is the
+// only way to see the 640-connection budget being approached.
+func RegisterSQLPool(instance string, db *sql.DB) {
+	if !live || db == nil {
+		return
+	}
+	registry.MustRegister(newSQLPoolCollector(instance, db.Stats))
+}
+
+// RegisterRedisPool exposes the client-side pool so Tair saturation is visible
+// before it turns into rate-limit degradation.
+func RegisterRedisPool(instance string, client *redis.Client) {
+	if !live || client == nil {
+		return
+	}
+	registry.MustRegister(newRedisPoolCollector(instance, client.PoolStats))
+}
+
+func sqlDesc(name, help string) *prometheus.Desc {
+	return prometheus.NewDesc(namespace+"_sql_"+name, help, []string{"instance"}, nil)
+}
+
+type sqlPoolCollector struct {
+	instance string
+	stats    func() sql.DBStats
+	descs    map[string]*prometheus.Desc
+}
+
+func newSQLPoolCollector(instance string, stats func() sql.DBStats) prometheus.Collector {
+	return &sqlPoolCollector{
+		instance: instance,
+		stats:    stats,
+		descs: map[string]*prometheus.Desc{
+			"max_open_connections":      sqlDesc("max_open_connections", "Configured maximum number of open connections."),
+			"open_connections":          sqlDesc("open_connections", "Number of established connections (in use plus idle)."),
+			"in_use":                    sqlDesc("in_use", "Number of connections currently in use."),
+			"idle":                      sqlDesc("idle", "Number of idle connections."),
+			"wait_count_total":          sqlDesc("wait_count_total", "Total connections waited for because the pool was exhausted."),
+			"wait_duration_seconds":     sqlDesc("wait_duration_seconds", "Total time blocked waiting for a connection."),
+			"max_idle_closed_total":     sqlDesc("max_idle_closed_total", "Total idle connections closed because of MaxIdleTime."),
+			"max_lifetime_closed_total": sqlDesc("max_lifetime_closed_total", "Total connections closed because of MaxLifetime."),
+		},
+	}
+}
+
+func (c *sqlPoolCollector) Describe(ch chan<- *prometheus.Desc) {
+	for _, desc := range c.descs {
+		ch <- desc
+	}
+}
+
+func (c *sqlPoolCollector) Collect(ch chan<- prometheus.Metric) {
+	stats := c.stats()
+	ch <- prometheus.MustNewConstMetric(c.descs["max_open_connections"], prometheus.GaugeValue, float64(stats.MaxOpenConnections), c.instance)
+	ch <- prometheus.MustNewConstMetric(c.descs["open_connections"], prometheus.GaugeValue, float64(stats.OpenConnections), c.instance)
+	ch <- prometheus.MustNewConstMetric(c.descs["in_use"], prometheus.GaugeValue, float64(stats.InUse), c.instance)
+	ch <- prometheus.MustNewConstMetric(c.descs["idle"], prometheus.GaugeValue, float64(stats.Idle), c.instance)
+	ch <- prometheus.MustNewConstMetric(c.descs["wait_count_total"], prometheus.CounterValue, float64(stats.WaitCount), c.instance)
+	ch <- prometheus.MustNewConstMetric(c.descs["wait_duration_seconds"], prometheus.CounterValue, stats.WaitDuration.Seconds(), c.instance)
+	ch <- prometheus.MustNewConstMetric(c.descs["max_idle_closed_total"], prometheus.CounterValue, float64(stats.MaxIdleClosed), c.instance)
+	ch <- prometheus.MustNewConstMetric(c.descs["max_lifetime_closed_total"], prometheus.CounterValue, float64(stats.MaxLifetimeClosed), c.instance)
+}
+
+func redisDesc(name, help string) *prometheus.Desc {
+	return prometheus.NewDesc(namespace+"_redis_"+name, help, []string{"instance"}, nil)
+}
+
+type redisPoolCollector struct {
+	instance string
+	stats    func() *redis.PoolStats
+	descs    map[string]*prometheus.Desc
+}
+
+func newRedisPoolCollector(instance string, stats func() *redis.PoolStats) prometheus.Collector {
+	return &redisPoolCollector{
+		instance: instance,
+		stats:    stats,
+		descs: map[string]*prometheus.Desc{
+			"hits_total":       redisDesc("hits_total", "Total connection pool hits."),
+			"misses_total":     redisDesc("misses_total", "Total connection pool misses that opened a new connection."),
+			"timeouts_total":   redisDesc("timeouts_total", "Total pool waits that timed out."),
+			"total_conns":      redisDesc("total_conns", "Current number of connections in the pool."),
+			"idle_conns":       redisDesc("idle_conns", "Current number of idle connections."),
+			"stale_conns":      redisDesc("stale_conns", "Current number of stale connections removed from the pool."),
+			"pending_requests": redisDesc("pending_requests", "Number of commands waiting for a connection."),
+		},
+	}
+}
+
+func (c *redisPoolCollector) Describe(ch chan<- *prometheus.Desc) {
+	for _, desc := range c.descs {
+		ch <- desc
+	}
+}
+
+func (c *redisPoolCollector) Collect(ch chan<- prometheus.Metric) {
+	stats := c.stats()
+	if stats == nil {
+		return
+	}
+	ch <- prometheus.MustNewConstMetric(c.descs["hits_total"], prometheus.CounterValue, float64(stats.Hits), c.instance)
+	ch <- prometheus.MustNewConstMetric(c.descs["misses_total"], prometheus.CounterValue, float64(stats.Misses), c.instance)
+	ch <- prometheus.MustNewConstMetric(c.descs["timeouts_total"], prometheus.CounterValue, float64(stats.Timeouts), c.instance)
+	ch <- prometheus.MustNewConstMetric(c.descs["total_conns"], prometheus.GaugeValue, float64(stats.TotalConns), c.instance)
+	ch <- prometheus.MustNewConstMetric(c.descs["idle_conns"], prometheus.GaugeValue, float64(stats.IdleConns), c.instance)
+	ch <- prometheus.MustNewConstMetric(c.descs["stale_conns"], prometheus.GaugeValue, float64(stats.StaleConns), c.instance)
+	ch <- prometheus.MustNewConstMetric(c.descs["pending_requests"], prometheus.GaugeValue, float64(stats.TotalConns-stats.IdleConns), c.instance)
+}
+
+// ObserveRateLimited counts a 429 emitted by a limiter.
+func ObserveRateLimited(mark string) {
+	if !live {
+		return
+	}
+	rateLimitedTotal.WithLabelValues(mark).Inc()
+}
+
+// ObserveRateLimitDegraded counts a limiter check that could not consult
+// Redis together with the fallback actually applied ("pass" or "memory").
+func ObserveRateLimitDegraded(mark, fallback string) {
+	if !live {
+		return
+	}
+	rateLimitDegradedTotal.WithLabelValues(mark, fallback).Inc()
+}
+
+// ObserveUpstreamError counts an upstream channel failure for SLO burn-rate
+// alerts. Labels stay low-cardinality: channel ids are operator-bounded and
+// error codes come from the fixed types.ErrorCode set.
+func ObserveUpstreamError(channelID int, statusCode int, errorCode string) {
+	if !live {
+		return
+	}
+	if errorCode == "" {
+		errorCode = "unknown"
+	}
+	upstreamErrorsTotal.WithLabelValues(strconv.Itoa(channelID), strconv.Itoa(statusCode), errorCode).Inc()
+}
+
+// Middleware records request count, in-flight gauge, and duration histogram.
+// The route label is the gin route template, never the raw URL, so path
+// parameters cannot explode series cardinality.
+//
+// Register it as the outermost middleware: the recovery handler must sit
+// inside it, otherwise a panicking request unwinds before the status code is
+// written and gets counted as 200.
+func Middleware() gin.HandlerFunc {
+	if !live {
+		return func(c *gin.Context) { c.Next() }
+	}
+	return func(c *gin.Context) {
+		method := c.Request.Method
+		inFlight := httpInFlight.WithLabelValues(method)
+		inFlight.Inc()
+		start := time.Now()
+		defer func() {
+			inFlight.Dec()
+			// Runs on the panic path too, so an aborted request is still counted.
+			route := c.FullPath()
+			if route == "" {
+				route = "unmatched"
+			}
+			httpRequestsTotal.WithLabelValues(route, method, strconv.Itoa(c.Writer.Status())).Inc()
+			httpRequestDuration.WithLabelValues(route, method).Observe(time.Since(start).Seconds())
+		}()
+		c.Next()
+	}
+}
