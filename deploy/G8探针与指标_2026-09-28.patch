diff --git a/controller/probe.go b/controller/probe.go
new file mode 100644
index 000000000..83f14edc8
--- /dev/null
+++ b/controller/probe.go
@@ -0,0 +1,107 @@
+package controller
+
+import (
+	"context"
+	"net/http"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/logger"
+	"github.com/QuantumNous/new-api/model"
+
+	"github.com/gin-gonic/gin"
+)
+
+// Dependency grades used by /readyz. The grade decides whether a failed
+// check makes the pod unservable, so it is the contract this endpoint exists
+// for - see the deployment guide's probe-degradation notes.
+//
+//	primary database  HARD   a pod that cannot read/write billing must not
+//	                       take traffic; ALB/K8s should pull it out.
+//	log database      SOFT   logs are outside the SLA evidence chain and a
+//	                       write failure degrades to dropping the row.
+//	redis / tair      SOFT   rate limiting fails open by design, so killing
+//	                       the pod here turns a cache blip into a outage.
+//
+// Responses carry only check names and states. Driver or DSN error text stays
+// in the server log, never in the HTTP body.
+const (
+	stateUp       = "up"
+	stateDegraded = "degraded"
+	stateDown     = "down"
+	stateDisabled = "disabled"
+)
+
+// Healthz is the liveness probe: process up, no dependency checks. It must
+// stay that way - a dependency-aware liveness probe restarts pods during the
+// exact outage it is supposed to ride through.
+func Healthz(c *gin.Context) {
+	c.JSON(http.StatusOK, gin.H{"status": "ok"})
+}
+
+// Readyz is the readiness probe: primary database hard, log database and
+// cache soft (reported as degraded but still serving).
+func Readyz(c *gin.Context) {
+	timeout := time.Duration(common.GetEnvOrDefault("READY_PROBE_TIMEOUT_MILLIS", 1000)) * time.Millisecond
+	ctx, cancel := context.WithTimeout(c.Request.Context(), timeout)
+	defer cancel()
+
+	checks := gin.H{}
+	note := func(name, state string) { checks[name] = state }
+
+	if err := pingPrimaryDB(ctx); err != nil {
+		logger.LogError(c.Request.Context(), "readyz primary database check failed: "+err.Error())
+		note("database", stateDown)
+		c.JSON(http.StatusServiceUnavailable, gin.H{"status": "not_ready", "checks": checks})
+		return
+	}
+	note("database", stateUp)
+
+	switch {
+	case model.LOG_DB == nil:
+		note("log_database", stateDisabled)
+	case model.LOG_DB == model.DB:
+		// No separate LOG_SQL_DSN: logs share the primary, already proven up.
+		note("log_database", stateUp)
+	case pingLogDB(ctx) != nil:
+		logger.LogError(c.Request.Context(), "readyz log database check failed, serving in degraded mode")
+		note("log_database", stateDegraded)
+	default:
+		note("log_database", stateUp)
+	}
+
+	switch {
+	case !common.RedisEnabled || common.RDB == nil:
+		note("cache", stateDisabled)
+	case common.RDB.Ping(ctx).Err() != nil:
+		logger.LogError(c.Request.Context(), "readyz cache check failed, serving in degraded mode")
+		note("cache", stateDegraded)
+	default:
+		note("cache", stateUp)
+	}
+
+	status := "ready"
+	if checks["log_database"] == stateDegraded || checks["cache"] == stateDegraded {
+		status = "degraded"
+	}
+	c.JSON(http.StatusOK, gin.H{"status": status, "checks": checks})
+}
+
+func pingPrimaryDB(ctx context.Context) error {
+	if model.DB == nil {
+		return context.DeadlineExceeded
+	}
+	sqlDB, err := model.DB.DB()
+	if err != nil {
+		return err
+	}
+	return sqlDB.PingContext(ctx)
+}
+
+func pingLogDB(ctx context.Context) error {
+	sqlDB, err := model.LOG_DB.DB()
+	if err != nil {
+		return err
+	}
+	return sqlDB.PingContext(ctx)
+}
diff --git a/controller/probe_test.go b/controller/probe_test.go
new file mode 100644
index 000000000..1742db839
--- /dev/null
+++ b/controller/probe_test.go
@@ -0,0 +1,188 @@
+package controller
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+
+	"github.com/gin-gonic/gin"
+	"github.com/glebarez/sqlite"
+	"github.com/go-redis/redis/v8"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+// useProbeSQLite gives /readyz a working primary database without running the
+// full startup migration set.
+func useProbeSQLite(t *testing.T) {
+	t.Helper()
+	previousDB := model.DB
+	previousLogDB := model.LOG_DB
+	db, err := gorm.Open(sqlite.Open("file:"+strings.ReplaceAll(t.Name(), "/", "_")+"?mode=memory&cache=shared"), &gorm.Config{})
+	require.NoError(t, err)
+	model.DB = db
+	model.LOG_DB = db
+	t.Cleanup(func() {
+		if sqlDB, err := db.DB(); err == nil {
+			_ = sqlDB.Close()
+		}
+		model.DB = previousDB
+		model.LOG_DB = previousLogDB
+	})
+}
+
+// useProbeRedis installs a cache client aimed at a closed port, which is how a
+// Tair outage looks to the process from inside.
+func useProbeRedis(t *testing.T, enabled bool) {
+	t.Helper()
+	previousEnabled := common.RedisEnabled
+	previousClient := common.RDB
+	common.RedisEnabled = enabled
+	if enabled {
+		common.RDB = redis.NewClient(&redis.Options{Addr: "127.0.0.1:1", DialTimeout: 200 * time.Millisecond})
+	} else {
+		common.RDB = nil
+	}
+	t.Cleanup(func() {
+		if common.RDB != nil {
+			_ = common.RDB.Close()
+		}
+		common.RedisEnabled = previousEnabled
+		common.RDB = previousClient
+	})
+}
+
+func performProbeRequest(t *testing.T, path string) *httptest.ResponseRecorder {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	router := gin.New()
+	router.GET("/healthz", Healthz)
+	router.GET("/readyz", Readyz)
+	recorder := httptest.NewRecorder()
+	router.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, path, nil))
+	return recorder
+}
+
+func decodeProbeBody(t *testing.T, recorder *httptest.ResponseRecorder) map[string]any {
+	t.Helper()
+	var body map[string]any
+	require.NoError(t, common.Unmarshal(recorder.Body.Bytes(), &body))
+	return body
+}
+
+// TestHealthzIgnoresDependencies pins the liveness contract: even with no
+// database and no cache the process reports healthy, because a dependency-aware
+// liveness probe restarts pods during the outage it should ride through.
+func TestHealthzIgnoresDependencies(t *testing.T) {
+	previousDB := model.DB
+	previousLogDB := model.LOG_DB
+	previousEnabled := common.RedisEnabled
+	previousClient := common.RDB
+	t.Cleanup(func() {
+		model.DB = previousDB
+		model.LOG_DB = previousLogDB
+		common.RedisEnabled = previousEnabled
+		common.RDB = previousClient
+	})
+
+	model.DB = nil
+	model.LOG_DB = nil
+	common.RedisEnabled = false
+	common.RDB = nil
+
+	recorder := performProbeRequest(t, "/healthz")
+	require.Equal(t, http.StatusOK, recorder.Code)
+	assert.Equal(t, "ok", decodeProbeBody(t, recorder)["status"])
+}
+
+// TestReadyzFailsClosedWithoutPrimaryDatabase: a pod that cannot reach the
+// billing database must be pulled out of rotation.
+func TestReadyzFailsClosedWithoutPrimaryDatabase(t *testing.T) {
+	previousDB := model.DB
+	previousLogDB := model.LOG_DB
+	t.Cleanup(func() {
+		model.DB = previousDB
+		model.LOG_DB = previousLogDB
+	})
+	model.DB = nil
+	model.LOG_DB = nil
+
+	recorder := performProbeRequest(t, "/readyz")
+	require.Equal(t, http.StatusServiceUnavailable, recorder.Code)
+	checks, ok := decodeProbeBody(t, recorder)["checks"].(map[string]any)
+	require.True(t, ok)
+	assert.Equal(t, stateDown, checks["database"])
+}
+
+// TestReadyzDegradedWhenCacheDown is the SLA-critical case: the cache being
+// unavailable keeps the pod serving, reported as degraded rather than not ready.
+func TestReadyzDegradedWhenCacheDown(t *testing.T) {
+	useProbeSQLite(t)
+	useProbeRedis(t, true)
+
+	recorder := performProbeRequest(t, "/readyz")
+	require.Equal(t, http.StatusOK, recorder.Code)
+	body := decodeProbeBody(t, recorder)
+	checks, ok := body["checks"].(map[string]any)
+	require.True(t, ok)
+	assert.Equal(t, "degraded", body["status"])
+	assert.Equal(t, stateUp, checks["database"])
+	assert.Equal(t, stateDegraded, checks["cache"])
+}
+
+func TestReadyzReportsDisabledCacheAsReady(t *testing.T) {
+	useProbeSQLite(t)
+	useProbeRedis(t, false)
+
+	recorder := performProbeRequest(t, "/readyz")
+	require.Equal(t, http.StatusOK, recorder.Code)
+	body := decodeProbeBody(t, recorder)
+	checks, ok := body["checks"].(map[string]any)
+	require.True(t, ok)
+	assert.Equal(t, "ready", body["status"])
+	assert.Equal(t, stateDisabled, checks["cache"])
+}
+
+// TestReadyzStaysReadyWhenLogDatabaseDown: the log database sits outside the
+// SLA evidence chain, so its failure may never remove a pod from rotation.
+func TestReadyzStaysReadyWhenLogDatabaseDown(t *testing.T) {
+	useProbeSQLite(t)
+	useProbeRedis(t, false)
+
+	previousLogDB := model.LOG_DB
+	logDB, err := gorm.Open(sqlite.Open("file:probe_log_down?mode=memory&cache=shared"), &gorm.Config{})
+	require.NoError(t, err)
+	sqlDB, err := logDB.DB()
+	require.NoError(t, err)
+	require.NoError(t, sqlDB.Close())
+	model.LOG_DB = logDB
+	t.Cleanup(func() { model.LOG_DB = previousLogDB })
+
+	recorder := performProbeRequest(t, "/readyz")
+	require.Equal(t, http.StatusOK, recorder.Code)
+	body := decodeProbeBody(t, recorder)
+	checks, ok := body["checks"].(map[string]any)
+	require.True(t, ok)
+	assert.Equal(t, "degraded", body["status"])
+	assert.Equal(t, stateDegraded, checks["log_database"])
+	assert.Equal(t, stateUp, checks["database"])
+}
+
+// TestReadyzBodyLeaksNoDependencyDetails: driver errors carry host and user
+// names, so only check states may reach the response body.
+func TestReadyzBodyLeaksNoDependencyDetails(t *testing.T) {
+	useProbeSQLite(t)
+	useProbeRedis(t, true)
+
+	raw := strings.ToLower(performProbeRequest(t, "/readyz").Body.String())
+	assert.NotContains(t, raw, "127.0.0.1")
+	assert.NotContains(t, raw, "dsn")
+	assert.NotContains(t, raw, stateDown)
+	assert.NotContains(t, raw, "ping")
+}
