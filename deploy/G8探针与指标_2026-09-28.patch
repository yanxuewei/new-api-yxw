+	Handler().ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/metrics", nil))
+	require.Equal(t, http.StatusOK, recorder.Code)
+	return recorder.Body.String()
+}
+
+// TestMiddlewareAndCountersCoverTheG8Signals: the SLO dashboard and the P1
+// alerts are built on these series, so a rename here is a dashboard break.
+func TestMiddlewareAndCountersCoverTheG8Signals(t *testing.T) {
+	Init("test-version")
+	t.Cleanup(func() { live = false })
+
+	gin.SetMode(gin.TestMode)
+	router := gin.New()
+	router.Use(Middleware())
+	router.POST("/v1/chat/completions", func(c *gin.Context) { c.Status(http.StatusTooManyRequests) })
+	router.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest(http.MethodPost, "/v1/chat/completions", nil))
+
+	ObserveRateLimited("GA")
+	ObserveRateLimitDegraded("GA", "pass")
+	ObserveUpstreamError(7, 503, "bad_response_status_code")
+
+	body := gather(t)
+	assert.Contains(t, body, `newapi_http_requests_total{code="429",method="POST",route="/v1/chat/completions"} 1`)
+	assert.Contains(t, body, `newapi_rate_limit_rejected_total{mark="GA"} 1`)
+	assert.Contains(t, body, `newapi_rate_limit_degraded_total{fallback="pass",mark="GA"} 1`)
+	assert.Contains(t, body, `newapi_relay_upstream_errors_total{channel="7",error_code="bad_response_status_code",status="503"} 1`)
+	assert.Contains(t, body, `newapi_build_info{`)
+	assert.Contains(t, body, "newapi_http_request_duration_seconds_bucket")
+}
+
+// TestMiddlewareIsANoopBeforeInit keeps an unconfigured deployment (the default,
+// METRICS_ENABLED=false) from recording anything or panicking.
+func TestMiddlewareIsANoopBeforeInit(t *testing.T) {
+	live = false
+	gin.SetMode(gin.TestMode)
+	router := gin.New()
+	router.Use(Middleware())
+	router.GET("/api/status", func(c *gin.Context) { c.Status(http.StatusOK) })
+
+	recorder := httptest.NewRecorder()
+	router.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/api/status", nil))
+	assert.Equal(t, http.StatusOK, recorder.Code)
+
+	handlerRecorder := httptest.NewRecorder()
+	Handler().ServeHTTP(handlerRecorder, httptest.NewRequest(http.MethodGet, "/metrics", nil))
+	assert.Equal(t, http.StatusNotFound, handlerRecorder.Code)
+}
diff --git a/pkg/httpmetrics/server.go b/pkg/httpmetrics/server.go
new file mode 100644
index 000000000..eefefac53
--- /dev/null
+++ b/pkg/httpmetrics/server.go
@@ -0,0 +1,63 @@
+package httpmetrics
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"time"
+)
+
+// Server is the internal metrics listener. It is deliberately separate from
+// the public application port: /metrics must not be reachable through the
+// ALB, WAF or GTM. Exposure is limited by container port plus NetworkPolicy,
+// and only the in-cluster Prometheus scrape should reach it.
+type Server struct {
+	srv *http.Server
+	ln  net.Listener
+}
+
+// ListenAndServe binds addr:port and serves /metrics in the background.
+// A read-header timeout is set so a stuck client cannot hold a connection.
+func ListenAndServe(addr string) (*Server, error) {
+	mux := http.NewServeMux()
+	mux.Handle("/metrics", Handler())
+
+	ln, err := net.Listen("tcp", addr)
+	if err != nil {
+		return nil, fmt.Errorf("metrics listener on %s: %w", addr, err)
+	}
+
+	srv := &http.Server{
+		Handler:           mux,
+		ReadHeaderTimeout: 5 * time.Second,
+	}
+	go func() {
+		if err := srv.Serve(ln); err != nil && !errors.Is(err, http.ErrServerClosed) {
+			ln.Close()
+			return
+		}
+	}()
+	return &Server{srv: srv, ln: ln}, nil
+}
+
+// Addr reports the bound address, useful when port 0 is requested.
+func (s *Server) Addr() string {
+	if s == nil || s.ln == nil {
+		return ""
+	}
+	return s.ln.Addr().String()
+}
+
+// Shutdown stops accepting scrapes; in-flight ones get the ctx deadline.
+func (s *Server) Shutdown(ctx context.Context) error {
+	if s == nil || s.srv == nil {
+		return nil
+	}
+	err := s.srv.Shutdown(ctx)
+	if s.ln != nil {
+		s.ln.Close()
+	}
+	return err
+}
