+// startMetricsServer binds the internal /metrics listener and registers the
+// pool collectors that make the connection budget observable. A bind failure is
+// logged, not fatal: telemetry must never take the gateway down.
+func startMetricsServer(addr string) *httpmetrics.Server {
+	if !common.MetricsEnabled {
+		return nil
+	}
+	if sqlDB, err := model.DB.DB(); err == nil {
+		httpmetrics.RegisterSQLPool("primary", sqlDB)
+	}
+	if model.LOG_DB != nil && model.LOG_DB != model.DB {
+		if sqlDB, err := model.LOG_DB.DB(); err == nil {
+			httpmetrics.RegisterSQLPool("log", sqlDB)
+		}
+	}
+	if common.RedisEnabled && common.RDB != nil {
+		httpmetrics.RegisterRedisPool("cache", common.RDB)
+	}
+	server, err := httpmetrics.ListenAndServe(addr)
+	if err != nil {
+		common.SysError("failed to start metrics listener: " + err.Error())
+		return nil
+	}
+	common.SysLog("metrics listening on " + server.Addr() + "/metrics")
+	return server
+}
